# Copy this file to .env.local and replace each placeholder locally.
# Never commit .env.local or secrets.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

# Generate with a password manager or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace_with_a_random_secret_at_least_32_characters"
CRON_SECRET="replace_with_a_different_random_secret_at_least_32_characters"

# Optional SMTP configuration. Leave unset to disable purchase emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
